# Python bytecode
__pycache__/
*.py[cod]

# Experiment artefacts. Every run writes a new timestamped directory under
# outputs/, so this must stay ignored or the repo grows on every run.
outputs/

# Derived analysis tables and figures. Regenerated from outputs/ by
# analysis/collect_runs.py, so they are reproducible rather than source.
analysis_artifacts/

# Fetched benchmark corpora. Reproducible from
# `python scripts/fetch_datasets.py`, large, and in GPQA's case not
# redistributable. The packaged synthetic samples under data/fixtures/ are
# source and stay tracked.
data/*/
!data/fixtures/

# Secrets. README references .env for ANTHROPIC_API_KEY / OPENAI_API_KEY.
.env

# Virtualenvs (scripts/run_*_vllm.sh reference a dedicated .venv-vllm)
.venv*/
venv/

# macOS
.DS_Store
